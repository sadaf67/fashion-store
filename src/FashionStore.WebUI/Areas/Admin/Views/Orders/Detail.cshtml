@using FashionStore.Domain.Entities
@using FashionStore.Domain.Enums
@model Order
@{ViewData["Title"]="جزئیات سفارش";Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<div class="d-flex justify-content-between"><div><h1 class="h3 fw-bold" dir="ltr">@Model.OrderNumber</h1><p class="text-muted">@Model.User?.FullName · @Model.User?.PhoneNumber</p></div><strong>@Model.FinalAmount.ToString("N0") تومان</strong></div><div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm p-3">@foreach(var i in Model.Items){<div class="d-flex justify-content-between border-bottom py-3"><span>@i.ProductName <small class="text-muted">@i.Size @i.Color × @i.Quantity</small></span><strong>@i.TotalPrice.ToString("N0")</strong></div>}</div></div><div class="col-lg-4"><form asp-action="UpdateStatus" method="post" class="card border-0 shadow-sm p-3"><input type="hidden" name="id" value="@Model.Id"/><label class="form-label">وضعیت</label><select name="status" class="form-select">@foreach(var s in Enum.GetValues<OrderStatus>()){<option value="@s" selected="@(s==Model.Status)">@s</option>}</select><label class="form-label mt-3">کد رهگیری</label><input name="trackingNumber" value="@Model.TrackingNumber" class="form-control"/><button class="btn btn-primary mt-3">بروزرسانی</button></form></div></div>
