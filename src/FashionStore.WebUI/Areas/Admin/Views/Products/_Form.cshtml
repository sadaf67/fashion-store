@using FashionStore.Domain.Entities
@using FashionStore.Domain.Enums
@model Product
@{var categories=ViewBag.Categories as IEnumerable<Category>??[];}
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label class="form-label">نام محصول</label><input asp-for="Name" class="form-control" required/></div><div class="col-md-4"><label class="form-label">برند</label><input asp-for="Brand" class="form-control"/></div><div class="col-md-4"><label class="form-label">دسته‌بندی</label><select asp-for="CategoryId" class="form-select" required><option value="">انتخاب</option>@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</select></div><div class="col-md-4"><label class="form-label">قیمت</label><input asp-for="Price" class="form-control" min="0" required/></div><div class="col-md-4"><label class="form-label">قیمت تخفیفی</label><input asp-for="DiscountedPrice" class="form-control" min="0"/></div><div class="col-12"><label class="form-label">توضیح کوتاه</label><input asp-for="ShortDescription" class="form-control"/></div><div class="col-12"><label class="form-label">توضیحات</label><textarea asp-for="Description" class="form-control" rows="5"></textarea></div><div class="col-md-6"><label class="form-label">تصویر اصلی</label><input type="file" name="primaryImage" class="form-control" accept="image/jpeg,image/png,image/webp"/></div><div class="col-md-6"><label class="form-label">تصویر پرو مجازی</label><input type="file" name="tryOnImage" class="form-control" accept="image/png,image/webp"/></div><div class="col-12 d-flex gap-4"><label><input asp-for="IsFeatured"/> محصول ویژه</label><label><input asp-for="IsTryOnEnabled"/> پرو مجازی</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button><a class="btn btn-light" asp-action="Index">انصراف</a></div></div>
