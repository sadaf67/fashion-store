@using FashionStore.Domain.Entities
@model IEnumerable<Product>
@{ViewData["Title"]="محصولات";Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 fw-bold">محصولات</h1><p class="text-muted">مدیریت کاتالوگ، قیمت و موجودی</p></div><a class="btn btn-primary" asp-action="Create">محصول جدید</a></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>محصول</th><th>دسته</th><th>قیمت</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.Name</strong><small class="d-block text-muted">@p.Brand · @p.Sku</small></td><td>@p.Category?.Name</td><td>@(p.DiscountedPrice??p.Price).ToString("N0") تومان</td><td>@p.Status</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">ویرایش</a><form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('محصول حذف شود؟')"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-danger">حذف</button></form></td></tr>}</tbody></table></div></div>
