@using FashionStore.Domain.Entities
@model IEnumerable<DeliveryZone>
@{
    ViewData["Title"] = "محدوده پیک";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 style="color:var(--blue-deep)">🚚 مدیریت محدوده پیک</h4>
    <a asp-action="Create" class="btn-primary-custom">+ افزودن محدوده</a>
</div>

<div class="row g-3">
    @foreach (var zone in Model)
    {
        <div class="col-md-4">
            <div class="admin-table-card p-4" style="border-right:4px solid @(zone.IsActive ? "var(--blue-dark)" : "var(--text-light)")">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 style="color:var(--blue-deep)">🚚 @zone.Name</h5>
                    @if (zone.IsActive)
                    { <span class="status-badge status-delivered">فعال</span> }
                    else
                    { <span class="status-badge status-cancelled">غیرفعال</span> }
                </div>
                @if (!string.IsNullOrEmpty(zone.Description))
                {
                    <p style="color:var(--text-mid);font-size:0.9rem;margin-bottom:1rem">@zone.Description</p>
                }
                <div class="d-flex gap-3 mb-3">
                    <div style="text-align:center">
                        <div style="font-weight:700;color:var(--blue-deep);font-size:1.1rem">@zone.DeliveryFee.ToString("N0")</div>
                        <small style="color:var(--text-light)">تومان هزینه</small>
                    </div>
                    <div style="text-align:center">
                        <div style="font-weight:700;color:var(--blue-deep);font-size:1.1rem">@zone.EstimatedDays روز</div>
                        <small style="color:var(--text-light)">زمان تحویل</small>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(zone.CoverageArea))
                {
                    <p style="font-size:0.82rem;color:var(--text-light);background:var(--cream);padding:8px;border-radius:8px">
                        📍 @zone.CoverageArea
                    </p>
                }
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@zone.Id" class="btn-blue" style="flex:1;text-align:center">ویرایش</a>
                    <form asp-action="Delete" asp-route-id="@zone.Id" method="post" style="flex:1">
                        <button class="btn w-100" style="background:#fee;color:#c0392b;border:1px solid #f5c6cb;border-radius:10px"
                                type="submit" onclick="return confirm('حذف شود؟')">حذف</button>
                    </form>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5" style="color:var(--text-light)">
            <div style="font-size:3rem">🚚</div>
            <h5 class="mt-3">هنوز محدوده‌ای تعریف نشده</h5>
        </div>
    }
</div>
