<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | پنل مدیریت</title>
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js برای نمودارها -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="admin-layout">

    <!-- ─── Sidebar ─────────────────────────────────────────────────── -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-logo">
            <span>👗 پنل مدیریت</span>
        </div>
        <nav class="sidebar-nav">
            <div class="sidebar-section">داشبورد</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="icon">📊</span> آمار و گزارش
            </a>

            <div class="sidebar-section">محصولات</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"
               asp-area="Admin" asp-controller="Products" asp-action="Index">
                <span class="icon">👗</span> مدیریت محصولات
            </a>
            <a class="sidebar-link" asp-area="Admin" asp-controller="Products" asp-action="Create">
                <span class="icon">➕</span> افزودن محصول
            </a>

            <div class="sidebar-section">سفارشات</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")"
               asp-area="Admin" asp-controller="Orders" asp-action="Index">
                <span class="icon">📦</span> مدیریت سفارشات
            </a>

            <div class="sidebar-section">کاربران و ارسال</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sms" ? "active" : "")"
               asp-area="Admin" asp-controller="Sms" asp-action="Index">
                <span class="icon">📱</span> پنل پیامک
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Delivery" ? "active" : "")"
               asp-area="Admin" asp-controller="Delivery" asp-action="Index">
                <span class="icon">🚚</span> محدوده پیک
            </a>

            <div class="sidebar-section">تنظیمات</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Discounts" ? "active" : "")"
               asp-area="Admin" asp-controller="Discounts" asp-action="Index">
                <span class="icon">🎫</span> کدهای تخفیف
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")"
               asp-area="Admin" asp-controller="Settings" asp-action="Index">
                <span class="icon">⚙️</span> تنظیمات سایت
            </a>

            <div class="sidebar-section">خروج</div>
            <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" style="margin:0">
                <button class="sidebar-link w-100 border-0 bg-transparent text-start" type="submit">
                    <span class="icon">🚪</span> خروج
                </button>
            </form>
        </nav>
    </aside>

    <!-- ─── Main Content ──────────────────────────────────────────── -->
    <div class="admin-main">
        <!-- Header -->
        <div class="admin-header">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm d-lg-none" onclick="document.getElementById('adminSidebar').classList.toggle('open')"
                        style="background:var(--cream-dark)">☰</button>
                <h5 class="mb-0" style="color:var(--blue-deep)">@ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Home" asp-action="Index" asp-area="" class="btn btn-sm"
                   style="background:var(--cream-dark);color:var(--blue-deep)">
                    🌐 مشاهده سایت
                </a>
                <span style="color:var(--text-light);font-size:0.9rem">👤 @User.Identity?.Name</span>
            </div>
        </div>

        <!-- Flash Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-3 mt-3" role="alert" style="border-radius:10px">
                ✅ @TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3" role="alert" style="border-radius:10px">
                ❌ @TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Page Content -->
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
