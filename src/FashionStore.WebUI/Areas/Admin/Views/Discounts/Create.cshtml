@using FashionStore.Domain.Entities
@using FashionStore.Domain.Enums
@model Discount
@{ViewData["Title"]="کد تخفیف جدید";Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";var categories=ViewBag.Categories as IEnumerable<Category>??[];}
<h1 class="h3 fw-bold mb-4">کد تخفیف جدید</h1><form method="post" class="card border-0 shadow-sm p-4"><div class="row g-3"><div class="col-md-4"><label class="form-label">کد</label><input asp-for="Code" class="form-control text-uppercase" required/></div><div class="col-md-4"><label class="form-label">نوع</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<DiscountType>()" class="form-select"></select></div><div class="col-md-4"><label class="form-label">مقدار</label><input asp-for="Value" class="form-control" min="0" required/></div><div class="col-md-6"><label class="form-label">شروع</label><input asp-for="StartDate" type="datetime-local" class="form-control" required/></div><div class="col-md-6"><label class="form-label">پایان</label><input asp-for="EndDate" type="datetime-local" class="form-control" required/></div><div class="col-md-4"><label class="form-label">حداقل سفارش</label><input asp-for="MinOrderAmount" class="form-control"/></div><div class="col-md-4"><label class="form-label">سقف تخفیف</label><input asp-for="MaxDiscountAmount" class="form-control"/></div><div class="col-md-4"><label class="form-label">تعداد استفاده</label><input asp-for="UsageLimit" class="form-control"/></div><div class="col-12"><label class="form-label">توضیحات</label><textarea asp-for="Description" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">ایجاد کد</button></div></div></form>
