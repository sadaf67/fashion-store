@using FashionStore.Domain.Entities
@model ApplicationUser
@{ ViewData["Title"] = "حساب کاربری"; var orders = ViewBag.Orders as IEnumerable<Order> ?? []; var addresses = ViewBag.Addresses as IEnumerable<Address> ?? []; }
<section class="page-hero compact"><div class="container"><span class="eyebrow">حساب من</span><h1>@Model.FullName</h1><p>@Model.Email · @Model.PhoneNumber</p></div></section>
<main class="container py-5"><div class="row g-4">
<div class="col-lg-7"><div class="checkout-card"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 fw-bold m-0">سفارش‌های من</h2><span class="badge text-bg-light">@orders.Count() سفارش</span></div>
@if(!orders.Any()){<div class="empty-state shadow-none m-0"><p>هنوز سفارشی ثبت نکرده‌اید.</p><a class="btn-blue" asp-controller="Shop" asp-action="Index">شروع خرید</a></div>}
else{foreach(var o in orders){<a class="order-row" asp-controller="Cart" asp-action="Confirmation" asp-route-id="@o.Id"><span><strong dir="ltr">@o.OrderNumber</strong><small>@o.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</small></span><span><strong>@o.FinalAmount.ToString("N0") تومان</strong><small>@o.Status</small></span></a>}}
</div></div>
<div class="col-lg-5"><div class="checkout-card"><h2 class="h4 fw-bold">آدرس‌های تحویل</h2>
@foreach(var a in addresses){<div class="address-card"><strong>@a.ReceiverName</strong><p>@a.Province، @a.City، @a.Street، @a.Detail</p><small>@a.Phone · @a.PostalCode</small><form asp-action="DeleteAddress" method="post" class="mt-2"><input type="hidden" name="id" value="@a.Id"/><button class="btn btn-sm btn-outline-danger">حذف</button></form></div>}
<button class="btn-outline-brand w-100 mt-3" data-bs-toggle="collapse" data-bs-target="#newAddress">افزودن آدرس جدید</button>
<div class="collapse mt-3" id="newAddress"><form asp-action="AddAddress" method="post" class="row g-2"><div class="col-12"><input class="form-control" name="ReceiverName" required placeholder="نام تحویل‌گیرنده"/></div><div class="col-12"><input class="form-control" name="Phone" required placeholder="موبایل" dir="ltr"/></div><div class="col-6"><input class="form-control" name="Province" required placeholder="استان"/></div><div class="col-6"><input class="form-control" name="City" required placeholder="شهر"/></div><div class="col-12"><input class="form-control" name="Street" required placeholder="خیابان"/></div><div class="col-12"><textarea class="form-control" name="Detail" required placeholder="پلاک، واحد و توضیحات"></textarea></div><div class="col-12"><input class="form-control" name="PostalCode" placeholder="کد پستی" dir="ltr"/></div><div class="col-12 form-check me-2"><input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="defaultAddress"/><label class="form-check-label" for="defaultAddress">آدرس پیش‌فرض</label></div><div class="col-12"><button class="btn-blue w-100">ذخیره آدرس</button></div></form></div>
</div></div></div></main>
