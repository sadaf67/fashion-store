@model FashionStore.WebUI.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "ثبت نام";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper py-5">
    <div class="container">
        <div class="auth-card" style="max-width:520px">
            <div class="text-center mb-4">
                <div style="font-size:3rem">✨</div>
                <h2>ایجاد حساب کاربری</h2>
                <p class="subtitle">به خانواده ما بپیوندید</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">👤 نام و نام خانوادگی</label>
                    <input asp-for="FullName" class="form-control" placeholder="مثلاً: علی احمدی">
                    <span asp-validation-for="FullName" class="text-danger" style="font-size:0.8rem"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">📧 ایمیل</label>
                    <input asp-for="Email" class="form-control" placeholder="example@email.com">
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">📱 شماره موبایل</label>
                    <input asp-for="Phone" class="form-control" placeholder="09123456789" dir="ltr">
                    <span asp-validation-for="Phone" class="text-danger" style="font-size:0.8rem"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label">🔒 رمز عبور</label>
                        <input asp-for="Password" class="form-control" placeholder="حداقل ۶ کاراکتر">
                        <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">🔒 تکرار رمز</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="تکرار رمز عبور">
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.8rem"></span>
                    </div>
                </div>

                <button type="submit" class="btn-primary-custom w-100 justify-content-center">ایجاد حساب</button>

                <p class="text-center mt-4" style="font-size:0.9rem;color:var(--text-mid)">
                    قبلاً ثبت‌نام کرده‌اید؟
                    <a asp-action="Login" style="color:var(--blue-dark);font-weight:700">وارد شوید</a>
                </p>
            </form>
        </div>
    </div>
</div>
