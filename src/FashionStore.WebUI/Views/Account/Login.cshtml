@model FashionStore.WebUI.Controllers.LoginViewModel
@{
    ViewData["Title"] = "ورود به حساب";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper py-5">
    <div class="container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <div style="font-size:3rem">👗</div>
                <h2>ورود به حساب کاربری</h2>
                <p class="subtitle">خوش آمدید! لطفاً وارد شوید</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" style="display:none" id="valSummary"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">📧 ایمیل</label>
                    <input asp-for="Email" class="form-control" placeholder="example@email.com" autocomplete="email">
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">🔒 رمز عبور</label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control" placeholder="رمز عبور" id="pwInput">
                        <button type="button" class="btn" style="background:var(--cream-dark);border:1.5px solid var(--cream-dark)"
                                onclick="togglePw()">👁</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                        <label asp-for="RememberMe" class="form-check-label" style="font-size:0.9rem">مرا به خاطر بسپار</label>
                    </div>
                </div>

                <button type="submit" class="btn-primary-custom w-100 justify-content-center">ورود به حساب</button>

                <p class="text-center mt-4" style="font-size:0.9rem;color:var(--text-mid)">
                    حساب ندارید؟
                    <a asp-action="Register" style="color:var(--blue-dark);font-weight:700">ثبت نام کنید</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function togglePw() {
    const pw = document.getElementById('pwInput');
    pw.type = pw.type === 'password' ? 'text' : 'password';
}
// نمایش validation summary اگر خطا وجود داشت
const vs = document.getElementById('valSummary');
if (vs && vs.querySelectorAll('li').length > 0) vs.style.display = 'block';
</script>
}
